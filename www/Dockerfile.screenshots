FROM mcr.microsoft.com/playwright:v1.60.0-noble

# Install pnpm
RUN npm install -g pnpm@9

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install

# Copy rest of app
COPY . .

# Build
RUN pnpm build

# Expose port for serve
EXPOSE 8080

# Default command: serve and generate screenshots
CMD ["sh", "-c", "pnpm exec serve dist -l 8080 -s & sleep 2 && pnpm exec scrns -o public/screenshots -s '.plotly svg rect' -E playwright -h localhost:8080 -l 120000"]
