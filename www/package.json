  "scripts": {
    "clean": "rm -rf node_modules/.vite",
    "gen-ymdgtb-index": "node scripts/gen-ymdgtb-index.js",
    "predev": "node scripts/gen-ymdgtb-index.js && node scripts/fetch-screenshots.js",
    "dev": "vite",
    "prebuild": "node scripts/gen-ymdgtb-index.js && node scripts/fetch-screenshots.js",
    "build": "vite build",
    "deploy:dev": "pnpm build && wrangler deploy --env dev",
    "postbuild": "node scripts/gen-station-stubs.js && node scripts/gen-version.js",
    "preview": "vite preview",
    "preview:cf": "wrangler dev",
    "lint": "eslint .",
    "tc": "tsc",
    "scrns": "scrns -o public/screenshots -s '.plotly svg rect' -l 30000 -h localhost:3456",
    "scrns:docker": "./scripts/docker-screenshots.sh",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:bundle": "playwright test --config=playwright.bundle.config.ts",
    "deploy:cf": "pnpm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hudcostreets/ctbk.dev"
